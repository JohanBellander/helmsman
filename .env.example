# Telegram — get token from @BotFather, get your numeric user ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Coolify — internal hostname works since helmsman runs on the coolify network.
# COOLIFY_ACCESS_TOKEN is what @masonator/coolify-mcp reads (NOT COOLIFY_API_TOKEN).
COOLIFY_BASE_URL=http://coolify:8000
COOLIFY_ACCESS_TOKEN=

# Beszel — internal hostname works for the same reason. Email/password is a Beszel
# admin (superuser) account — needed by Red5d/beszel-mcp for most operations.
BESZEL_URL=http://beszel:8090
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Shared secret Beszel sends in an Authorization: Bearer header when firing webhooks.
# Generate with: openssl rand -hex 32
BESZEL_WEBHOOK_SECRET=

# Optional
LOG_LEVEL=INFO

# Inference backend: "anthropic" (Claude Haiku 4.5) or "llamacpp" (local
# llama.cpp server, OpenAI-compatible /v1 API — also works with vLLM, LM
# Studio, Ollama's /v1 endpoint, TGI, etc.).
#   - When BACKEND=anthropic, default BACKEND_FALLBACK is empty (no fallback).
#   - When BACKEND=llamacpp, default BACKEND_FALLBACK is "anthropic" (Haiku
#     catches connection errors and timeouts on the primary).
# Set BACKEND_FALLBACK= (empty) explicitly to disable the safety net.
BACKEND=anthropic
BACKEND_FALLBACK=

# Required when BACKEND or BACKEND_FALLBACK is "llamacpp". LLAMACPP_BASE_URL is
# the OpenAI-compatible endpoint, e.g. https://llm.example.com/v1.
# LLAMACPP_API_KEY is the bearer token if the server requires auth (leave
# empty if not). LLAMACPP_MODEL is the model name the server expects.
# LLAMACPP_TIMEOUT_SEC bounds a single inference; on exceed, fall back to
# Anthropic for the rest of that turn.
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=
LLAMACPP_MODEL=
LLAMACPP_TIMEOUT_SEC=60
# Inference temperature. Lower (~0.3-0.5) makes tool selection more reliable
# on dense tool lists; too low and voice variation suffers.
LLAMACPP_TEMPERATURE=0.5

# Background log scanner — Coolify only for v1. Polls each app's recent logs and
# pushes a Telegram alert when a conservative pattern matches (OOMKilled, panic,
# Traceback, FATAL, segfault/SIGKILL, unhandled exception). Cooldown prevents
# repeat alerts on the same (app, pattern) within the window.
LOG_SCAN_ENABLED=true
LOG_SCAN_INTERVAL_SEC=600
LOG_SCAN_LINES=200
LOG_SCAN_COOLDOWN_SEC=1800
# Comma-separated app-name substrings (case-insensitive) to skip during scan.
# Empty by default — every app is scanned, including Helmsman itself. Add
# noisy apps you don't want investigated.
LOG_SCAN_EXCLUDE=
# Comma-separated `app:pattern` pairs (case-insensitive). Skips the named
# pattern only when scanning apps whose name contains `app` as a substring;
# the app stays under scan for every other pattern. Pattern names: oom, panic,
# traceback, fatal, segfault, unhandled.
# Example: deadbolt:fatal — silence the `fatal` pattern for Deadbolt, whose
# CVE tool results echo `"severity": "CRITICAL"` JSON values that would
# otherwise trip the scanner.
LOG_SCAN_EXCLUDE_PATTERNS=deadbolt:fatal
