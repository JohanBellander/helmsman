# Telegram — get token from @BotFather, get your numeric user ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Coolify — internal hostname works since helmsman runs on the coolify network.
# COOLIFY_ACCESS_TOKEN is what @masonator/coolify-mcp reads (NOT COOLIFY_API_TOKEN).
COOLIFY_BASE_URL=http://coolify:8000
COOLIFY_ACCESS_TOKEN=

# Beszel — internal hostname works for the same reason. Email/password is a Beszel
# admin (superuser) account — needed by Red5d/beszel-mcp for most operations.
BESZEL_URL=http://beszel:8090
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Shared secret Beszel sends in an Authorization: Bearer header when firing webhooks.
# Generate with: openssl rand -hex 32
BESZEL_WEBHOOK_SECRET=

# Optional
LOG_LEVEL=INFO

# Inference backend: "anthropic" (Claude Haiku 4.5) or "ollama" (local).
#   - When BACKEND=anthropic, default BACKEND_FALLBACK is empty (no fallback).
#   - When BACKEND=ollama, default BACKEND_FALLBACK is "anthropic" (Haiku
#     catches connection errors and timeouts on the primary).
# Set BACKEND_FALLBACK= (empty) explicitly to disable the safety net.
BACKEND=anthropic
BACKEND_FALLBACK=

# Required when BACKEND or BACKEND_FALLBACK is "ollama". OLLAMA_BASE_URL is the
# host's API endpoint (port 11434 by default). OLLAMA_MODEL is the tagged model
# name. OLLAMA_TIMEOUT_SEC bounds a single inference; on exceed, fall back to
# Anthropic for the rest of that turn.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SEC=60

# Background log scanner — Coolify only for v1. Polls each app's recent logs and
# pushes a Telegram alert when a conservative pattern matches (OOMKilled, panic,
# Traceback, FATAL, segfault/SIGKILL, unhandled exception). Cooldown prevents
# repeat alerts on the same (app, pattern) within the window.
LOG_SCAN_ENABLED=true
LOG_SCAN_INTERVAL_SEC=600
LOG_SCAN_LINES=200
LOG_SCAN_COOLDOWN_SEC=1800
# Comma-separated app-name substrings (case-insensitive) to skip during scan.
# Empty by default — every app is scanned, including Helmsman itself. Add
# noisy apps you don't want investigated.
LOG_SCAN_EXCLUDE=
